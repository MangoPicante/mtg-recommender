# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# This file is a template that IS checked in, so it must never contain real
# secrets. Only placeholder / example values belong here.

# ---------------------------------------------------------------------------
# MongoDB Atlas (Phase 1 — persistence layer)
# ---------------------------------------------------------------------------
# SRV connection string from the Atlas UI (Database -> Connect -> Drivers).
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Database + collection the fetcher / embedder / recommender all point at.
# One wide document per card, keyed by scryfall_id (see PLAN.md Phase 1).
MONGODB_DB=mtg_recommender
MONGODB_CARDS_COLLECTION=cards

# ---------------------------------------------------------------------------
# Opt-in integration tests (tests/integration/)
# ---------------------------------------------------------------------------
# Only set this when you want the integration test suite to run; without
# it, those tests silently skip. Each test class creates a disposable
# uuid-suffixed database on this URI and drops it in tearDownClass, so a
# shared cluster is fine — the test db will never collide with the real
# MONGODB_DB above.
#
# MONGODB_INTEGRATION_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
